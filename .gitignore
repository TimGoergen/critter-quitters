# Godot 4 .gitignore

# Godot-specific ignores
.godot/
*.translation

# Imported assets (generated by Godot)
*.import
# Exception: service_fee_icon.svg.import is committed because svg/scale=4.0 must
# be explicit to prevent Godot from rasterising the 80×52 SVG at 1× (blurry when
# displayed at 196×128 in HubScreen). Without this file the CI would regenerate
# it at scale=1.0 (default).
!game/assets/service_fee_icon.svg.import

# OS-specific
.DS_Store
Thumbs.db

# Build output — produced by export pipeline, never committed
dist/

# Android signing key — secret, never commit; decode from ANDROID_KEYSTORE_BASE64 secret in CI
build/android_release.keystore
